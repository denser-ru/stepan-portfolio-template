---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Проекты | Stepan Portfolio">
	<h1>Мои Проекты</h1>
	<p class="desc">Здесь собраны системы и игры, которые я спроектировал.</p>

	<div class="projects-grid">
		<div class="project-card">
			<div class="image-wrapper">
				<img src="https://images.unsplash.com/photo-1550745165-9bc0b252726f?auto=format&fit=crop&w=600&q=80" alt="Game preview" />
			</div>
			<div class="card-content">
				<div class="tags">
					<span class="tag">Python</span>
					<span class="tag">Pygame</span>
					<span class="tag">OOP</span>
				</div>
				<h3>🎮 Лесной Арканоид</h3>
				<p class="project-text">
					Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.
				</p>
			</div>
		</div>
	</div>
</Layout>

<style>
	h1 { margin-bottom: 0.5rem; }
	.desc { color: var(--text-muted); margin-bottom: 2rem; }
	.projects-grid {
		display: grid;
		gap: 2rem;
	}
	.project-card {
		background: var(--card-bg);
		border: 1px solid var(--border);
		border-radius: 8px;
		overflow: hidden;
	}
	.image-wrapper {
		width: 100%;
		height: 200px;
	}
	.image-wrapper img {
		width: 100%;
		height: 100%;
	}
	.card-content {
		padding: 1.5rem;
	}
	.tags {
		display: flex;
		gap: 0.5rem;
		margin-bottom: 0.8rem;
	}
	.tag {
		background: #0f172a;
		border: 1px solid var(--border);
		color: var(--accent);
		font-size: 0.75rem;
		padding: 0.2rem 0.5rem;
		border-radius: 4px;
		font-weight: bold;
	}
	.project-card h3 {
		margin-bottom: 0.5rem;
		color: var(--text-main);
	}
	.project-text {
		color: var(--text-muted);
		font-size: 0.95rem;
	}
</style>
