---
import Layout from '../layouts/Layout.astro';
// Магия: Astro сам находит все .md файлы в папке projects
const projects = await Astro.glob('../content/projects/*.md');
---

<Layout title="Проекты | Stepan Portfolio">
	<h1>Мои Проекты</h1>
	<p class="desc">Здесь собраны системы и игры, которые я спроектировал.</p>

	<div class="projects-grid">
		{projects.map((proj) => (
			<div class="project-card">
				<div class="image-wrapper">
					<!-- возможен БАГ (сплющенная картинка) -->
					<img src={proj.frontmatter.image} alt="Превью" />
				</div>
				<div class="card-content">
					<div class="tags">
						{proj.frontmatter.tags.map((tag) => (
							<span class="tag">{tag}</span>
						))}
					</div>
					<h3>{proj.frontmatter.title}</h3>
					<div class="project-text">
						<!-- Сюда автоматически вставляется текст из .md файла -->
						<proj.Content />
					</div>
				</div>
			</div>
		))}
	</div>
</Layout>

<style>
	h1 { margin-bottom: 0.5rem; }
	.desc { color: var(--text-muted); margin-bottom: 2rem; }
	.projects-grid { display: grid; gap: 2rem; }
	.project-card { background: var(--card-bg); border: 1px solid var(--border); border-radius: 8px; overflow: hidden; }
	.image-wrapper { width: 100%; height: 200px; }
	.image-wrapper img { width: 100%; height: 100%; }
	.card-content { padding: 1.5rem; }
	.tags { display: flex; gap: 0.5rem; margin-bottom: 0.8rem; }
	.tag { background: #0f172a; border: 1px solid var(--border); color: var(--accent); font-size: 0.75rem; padding: 0.2rem 0.5rem; border-radius: 4px; font-weight: bold; }
	h3 { margin-bottom: 0.5rem; color: var(--text-main); }
	.project-text { color: var(--text-muted); font-size: 0.95rem; }
</style>
