---
<header>
	<div class="nav-container">
		<a href="/" class="logo">⚡ Stepan.dev</a>
		<nav>
			<a href="/">Главная</a>
			<a href="/projects">Проекты</a>
			<a href="/blog">Блог</a>
		</nav>
	</div>
</header>

<style>
	header {
		background-color: rgba(15, 23, 42, 0.8);
		backdrop-filter: blur(8px);
		border-bottom: 1px solid var(--border);
		position: sticky;
		top: 0;
		z-index: 10;
	}
	.nav-container {
		max-width: 800px;
		margin: 0 auto;
		padding: 1rem;
		display: flex;
		justify-content: space-between;
		align-items: center;
	}
	.logo {
		font-weight: 700;
		font-size: 1.2rem;
		color: var(--text-main);
	}
	nav {
		display: flex;
		gap: 1.5rem;
	}
	nav a {
		color: var(--text-muted);
		font-weight: 500;
	}
	nav a:hover {
		color: var(--text-main);
	}
</style>
